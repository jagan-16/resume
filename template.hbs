<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{name}} – Resume</title>
    <style>
{{{inlineCSS}}}
    </style>
</head>
<body>

    <h1>{{name}}</h1>

    <div class="contact-info">
        {{#if contact.phone}}{{contact.phone}}{{/if}}
        {{#if contact.email}} &nbsp;|&nbsp; ✉️ {{contact.email}}{{/if}}
        {{#if contact.linkedin}} &nbsp;|&nbsp; 🔗 {{contact.linkedin}}{{/if}}
        {{#if contact.github}} &nbsp;|&nbsp; 💻 {{contact.github}}{{/if}}
        {{#if contact.portfolio}} &nbsp;|&nbsp; 🌐 {{contact.portfolio}}{{/if}}
    </div>

    {{#if summary}}
    <h2>SUMMARY</h2>
    <p>{{summary}}</p>
    {{/if}}

    {{#if education.length}}
    <h2>EDUCATION</h2>
    {{#each education}}
    <h3>{{degree}} <span class="date">{{date}}</span></h3>
    <p>{{institution}}<br>
    {{#if cgpa}}CGPA: {{cgpa}}{{/if}}
    {{#if gpa}}GPA: {{gpa}}{{/if}}
    {{#if grade}}Grade: {{grade}}{{/if}}
    </p>
    {{/each}}
    {{/if}}

    {{#if skills}}
    <h2>TECHNICAL SKILLS</h2>
    <div class="skills-grid">
        {{#each skills}}
        <div class="skills-category">
            <h4>{{category}}:</h4>
            <p>{{join items ", "}}</p>
        </div>
        {{/each}}
    </div>
    {{/if}}

    {{#if experience.length}}
    <h2>INTERNSHIP EXPERIENCE</h2>
    {{#each experience}}
    <h3>{{company}} – {{role}} <span class="date">{{date}}</span></h3>
    <ul>
        {{#each points}}
        <li>{{this}}</li>
        {{/each}}
    </ul>
    {{/each}}
    {{/if}}

    {{#if projects.length}}
    <h2>PROJECTS</h2>
    {{#each projects}}
    <h3>{{name}}{{#if tech}} ({{join tech ", "}}){{/if}}</h3>
    <ul>
        {{#each points}}
        <li>{{this}}</li>
        {{/each}}
    </ul>
    {{/each}}
    {{/if}}

    {{#if achievements.length}}
    <h2>ACHIEVEMENTS</h2>
    <ul>
        {{#each achievements}}
        <li><strong>{{title}}</strong>
            {{#if points.length}}
            <ul>
                {{#each points}}
                <li>{{this}}</li>
                {{/each}}
            </ul>
            {{/if}}
        </li>
        {{/each}}
    </ul>
    {{/if}}

    {{#if certifications.length}}
    <h2>CERTIFICATIONS</h2>
    <ul>
        {{#each certifications}}
        <li>{{this}}</li>
        {{/each}}
    </ul>
    {{/if}}

    {{#if additionalInfo}}
    <h2>ADDITIONAL INFORMATION</h2>
    <ul>
        {{#if additionalInfo.languages.length}}
        <li><strong>Languages:</strong> {{join additionalInfo.languages ", "}}.</li>
        {{/if}}
        {{#if additionalInfo.volunteer.length}}
        <li><strong>Volunteer Experience:</strong> {{join additionalInfo.volunteer ", "}}.</li>
        {{/if}}
        {{#if additionalInfo.interests.length}}
        <li><strong>Interests:</strong> {{join additionalInfo.interests ", "}}.</li>
        {{/if}}
    </ul>
    {{/if}}

</body>
</html>
